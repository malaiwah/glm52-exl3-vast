+static DINLINE FlagType load_flag_gpu(FlagType *address) {
+  FlagType value;
+  asm volatile("ld.relaxed.gpu.global.u32 %0, [%1];"
+               : "=r"(value)
+               : "l"(address)
+               : "memory");
+  return value;
