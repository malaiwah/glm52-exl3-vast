+
+__global__ void advance_staging_slot_kernel(Signal *self) {
+  if (threadIdx.x == 0) {
+    const FlagType generation = self->staging_generation;
+    self->active_staging_slot = generation & FlagType{1};
+    self->staging_generation = generation + FlagType{1};
+  }
+}
