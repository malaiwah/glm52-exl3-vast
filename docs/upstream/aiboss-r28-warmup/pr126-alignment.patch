-    counts.append(capacity)
+    bucket = 1
+    while bucket <= capacity:
+        first_in_bucket = 1 if bucket == 1 else bucket // 2 + 1
+        for count in (first_in_bucket, bucket):
+            if count <= capacity and (not counts or counts[-1] != count):
+                counts.append(count)
+        bucket *= 2
+    if counts[-1] != capacity:
+        counts.append(capacity)
     return tuple(counts)
 
 
